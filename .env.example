# ─────────────────────────────────────────────────────────────
#  PLANTILLA de variables de entorno (COPIAR a .env y completar)
#  ⚠️ El archivo .env real está gitignoreado — NUNCA se commitea.
# ─────────────────────────────────────────────────────────────

# Conexión al data lake de JANIS (ClickHouse, interfaz HTTPS)
CLICKHOUSE_HOST=quantics.data-lake.janis.in
CLICKHOUSE_PORT=8443
CLICKHOUSE_PROTOCOL=https
CLICKHOUSE_USER=tu_usuario_aqui
CLICKHOUSE_PASSWORD=tu_password_aqui
CLICKHOUSE_DATABASE=janis_datawarehouse_masonline

# Esquema usado en las queries (el front del lake usaba "datalake";
# si las tablas están bajo otro schema, cambialo acá).
CLICKHOUSE_SCHEMA=datalake

# Dominio permitido para login (Google Workspace)
ALLOWED_EMAIL_DOMAIN=gdnargentina.com

# (Opcional, solo para puerto MySQL si se usa en el futuro)
# MYSQL_PORT=3306
