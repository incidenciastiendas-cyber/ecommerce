# Copiar a functions/.env y completar (gitignoreado).
# Para PRODUCCIÓN, el password va como secret:
#   firebase functions:secrets:set CLICKHOUSE_PASSWORD
# El resto pueden ir en functions/.env (no secretos críticos) o como secrets.

CLICKHOUSE_HOST=quantics.data-lake.janis.in
CLICKHOUSE_PORT=8443
CLICKHOUSE_PROTOCOL=https
CLICKHOUSE_USER=tu_usuario_aqui
CLICKHOUSE_DATABASE=janis_datawarehouse_masonline
CLICKHOUSE_SCHEMA=datalake
ALLOWED_EMAIL_DOMAIN=gdnargentina.com

# CLICKHOUSE_PASSWORD  -> NO ponerlo acá en prod; usar secrets.
# Para desarrollo local sí podés ponerlo en functions/.env:
# CLICKHOUSE_PASSWORD=tu_password_aqui
